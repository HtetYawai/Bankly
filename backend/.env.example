# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── User authentication ────────────────────────────────────────────────────────
# Used by the login controller and the protect middleware.
JWT_SECRET=replace_with_a_long_random_string

# ── Admin authentication ───────────────────────────────────────────────────────
# Separate secret for admin JWTs. Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string

# ── Admin seed (seed:admin script only) ───────────────────────────────────────
# These three variables are only read by: npm run seed:admin
# After running the seed you may remove them from .env if you prefer,
# though keeping them here does no harm because .env is git-ignored.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=12345678

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Legacy (kept for reference) ───────────────────────────────────────────────
DATABASE_PASSWORD=your_db_password
